# SASL config
echo "pwcheck_method: auxprop
auxprop_plugin: sasldb
mech_list: CRAM-MD5" > /etc/postfix/sasl/smtpd.conf

echo $SMTP_PASS | saslpasswd2 -c -u "$DOMAIN" $SMTP_USER

chown postfix:postfix /etc/sasldb2
chmod 640 /etc/sasldb2

# curl-email.sh script
cat > /usr/local/bin/curl-email.sh <<EOF
#!/bin/sh
# Enable temporary debug logs:
# echo "\$(date -Iseconds) SCRIPT STARTED sender=\$1 recipient=\$2" >> /var/log/mail/curl-email.log
body=\$(mktemp /tmp/curl-email.XXXXXX)
# Percent-encode '+' so the API's query parser doesn't decode it back to a
# space (aliases commonly use '+', e.g. plus-tagged/reply-encoded addresses).
encoded_recipient=\$(printf '%s' "\$2" | sed 's/+/%2B/g')
http_code=\$(curl --silent --data-binary @- \\
  -H "Authorization: Bearer $PSK" \\
  -X POST "$API_URL/v1/email?recipient=\$encoded_recipient" \\
  -o "\$body" -w "%{http_code}")
resp_body=\$(cat "\$body")
rm -f "\$body"
# Enable temporary debug logs:
# echo "\$(date -Iseconds) sender=\$1 recipient=\$2 http_code=\$http_code body=\$resp_body" >> /var/log/mail/curl-email.log
if [ "\$http_code" -lt 200 ] || [ "\$http_code" -ge 300 ]; then
    exit 75
fi
exit 0
EOF
chmod +x /usr/local/bin/curl-email.sh

# Ensure curl-email debug log exists and is writable by the pipe's 'nobody' user
touch /var/log/mail/curl-email.log
chmod 666 /var/log/mail/curl-email.log

# Add curl_email service to master.cf
postconf -M "curl_email/unix=curl_email unix - n n - - pipe flags=RqX user=nobody argv=/usr/local/bin/curl-email.sh \${sender} \${recipient}"

# reload Postfix to apply changes
postfix reload
